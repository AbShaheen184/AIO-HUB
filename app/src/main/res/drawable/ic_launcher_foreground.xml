<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground of the "AIO Hub" launcher icon.

  A hub: a ring with four nodes plugged into it and a play triangle in the
  middle — everything the app carries, hanging off one centre.

  The glyph is drawn inside the 72x72 safe zone of the 108x108 adaptive-icon
  canvas (18..90), so no launcher mask can cut it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ring of the hub. -->
    <path
        android:pathData="M54,27 A27,27 0 1,0 54,81 A27,27 0 1,0 54,27 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5" />

    <!-- The four nodes: movies, series, anime, music, live TV, games. -->
    <path
        android:pathData="M34.9,34.9 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z"
        android:fillColor="#FF4ECDC4" />
    <path
        android:pathData="M73.1,34.9 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z"
        android:fillColor="#FF4ECDC4" />
    <path
        android:pathData="M73.1,73.1 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z"
        android:fillColor="#FF4ECDC4" />
    <path
        android:pathData="M34.9,73.1 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z"
        android:fillColor="#FF4ECDC4" />

    <!-- The play triangle in the middle. -->
    <path
        android:pathData="M47,41 L47,67 L68,54 Z"
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round" />

</vector>
