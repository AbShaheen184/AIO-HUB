<?xml version="1.0" encoding="utf-8"?>
<!--
  The background plate of the "AIO Hub" launcher icon.

  A deep indigo that fades to near-black, so the white ring and the teal
  nodes of the foreground read on every launcher background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF2E2180"
                android:centerColor="#FF1B1645"
                android:endColor="#FF08080F" />
        </aapt:attr>
    </path>

</vector>
